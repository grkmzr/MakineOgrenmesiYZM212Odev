    "import numpy as np\n",
    "\n",
    "# Matris tanımı\n",
    "A = np.array([[4, 2],\n",
    "              [1, 3]])\n",
    "\n",
    "# Özdeğer ve özvektör hesaplama\n",
    "values, vectors = np.linalg.eig(A)\n",
    "\n",
    "print(\"Özdeğerler:\")\n",
    "print(values)\n",
    "\n",
    "print(\"\\nÖzvektörler:\")\n",
    "print(vectors)"
   ]
